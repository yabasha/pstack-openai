{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Behavioral acceptance case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "sourcePaths",
    "prompt",
    "requirements",
    "expectedFull",
    "expectedReduced",
    "expectedBlocked",
    "forbiddenClaims"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "sourcePaths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "expectedFull": {
      "type": "string",
      "minLength": 1
    },
    "expectedReduced": {
      "type": "string",
      "minLength": 1
    },
    "expectedBlocked": {
      "type": "string",
      "minLength": 1
    },
    "forbiddenClaims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
