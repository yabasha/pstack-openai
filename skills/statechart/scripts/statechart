#!/bin/sh
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in /*) self=$link ;; *) self=$(dirname "$self")/$link ;; esac
done
if ! command -v bun >/dev/null 2>&1; then
  echo "statechart needs an already installed Bun runtime." >&2
  exit 127
fi
exec bun --no-install "$(dirname "$self")/statechart.ts" "$@"
